---
interface Props {
  id: string
  bg: "bg-stone" | "bg-forest"
  headerBg: "stone" | "forest"
  class?: string
}

const { id, bg, headerBg, class: className = "" } = Astro.props

const textClass = bg === "bg-forest" ? "text-white" : ""
---

<section
  id={id}
  data-header-bg={headerBg}
  class:list={["w-full scroll-mt-16", bg, textClass, className]}
>
  <div class="mx-auto w-full max-w-7xl px-page sm:px-page-sm">
    <slot />
  </div>
</section>
