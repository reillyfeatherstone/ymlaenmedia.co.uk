---
// The "Ymlaen Media" logo. The page's JS toggles `data-mark` on the header
// (an ancestor of this element) to collapse the word down to a dot as the
// next section scrolls in.
---

<a
  id="brand"
  href="/"
  aria-label="Ymlaen Media, home"
  class="group inline-flex items-baseline no-underline text-[#1F2B24] transition-opacity duration-300 hover:opacity-70
       focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F2B24]"
>
  <span
    aria-hidden="true"
    class="font-['Archivo',sans-serif] font-extrabold tracking-[-0.07em]"
  >
    Y
  </span>

  <span
    aria-hidden="true"
    class="inline-block w-(--w-text,auto) [clip-path:inset(-0.2em_0)]
         transition-[width] duration-600 delay-100 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none
         group-data-mark:w-0 group-data-mark:delay-0"
  >
    <span
      id="brand-word"
      class="inline-block whitespace-nowrap font-['Archivo',sans-serif] font-extrabold tracking-tight
         transition-opacity duration-300 delay-100 motion-reduce:transition-none
         group-data-mark:opacity-0 group-data-mark:delay-0"
    >
      mlaen
    </span>
  </span>

  <span
    aria-hidden="true"
    class="inline-block size-[0.16em] w-0 rounded-full bg-[#8e9a4e] opacity-0
         transition-[width,margin,opacity] duration-300 ease-out motion-reduce:transition-none
         group-data-mark:ml-[0.06em] group-data-mark:w-[0.16em] group-data-mark:opacity-100
         group-data-mark:delay-300 group-data-mark:duration-500"
  ></span>

  <span class="ml-[0.24em] font-light tracking-tight">Media</span>
</a>
