---
import "../styles/global.css"
import Brand from "../components/Brand.astro"
import { Image } from "astro:assets"
import landscapeImage from "../assets/landscape.webp"
import { IconArrowNarrowRight } from "@tabler/icons-preact"

const showcase = [
  {
    name: "Morfa Plumbing",
    trade: "Plumbing & heating",
    blurb: "A one-pager that turns emergency call-outs into booked jobs.",
  },
  {
    name: "Bae Electrical",
    trade: "Electrical services",
    blurb: "Certifications front and centre, with a quote form one tap away.",
  },
  {
    name: "Cwm Renovations",
    trade: "Building & renovations",
    blurb: "A before-and-after gallery that sells the craft for them.",
  },
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Ymlaen Media | Web Design</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header id="header" class="fixed inset-x-0 top-0 z-99 px-5 text-black">
      <div class="mx-auto flex h-16 max-w-400 items-center justify-between">
        <div class="font-display text-3xl leading-none">
          <Brand />
        </div>
        <nav id="nav" class="flex gap-6">
          <a href="#what-we-do">What We Do</a>
          <a href="#work">Work</a>
        </nav>
      </div>
    </header>

    <div id="smoother-wrapper">
      <div id="smoother-content">
        <section
          id="hero"
          class="min-h-svh bg-[url('/hero.webp')] bg-cover bg-center bg-no-repeat"
        >
          <div class="mx-auto flex w-full max-w-400 flex-col items-center px-page text-center sm:px-page-sm gap-15">
            <div class="flex flex-col gap-2 pt-30 text-6xl font-base sm:font-medium md:pt-35 text-white mix-blend-difference sm:pt-35 sm:text-7xl lg:pt-45 lg:text-9xl">
              <span>Small Business </span>
              <span>Web Design</span>
            </div>

            <div id="cta" class="mt-auto mb-[40vh]">
              <button
                type="button"
                class="group flex relative isolate overflow-hidden items-center gap-3 rounded-full border border-[#1F2B24] bg-[#1F2B24] px-7 py-3 tracking-wide text-white shadow-lg shadow-black/20 hover:cursor-pointer"
              >
                <span class="absolute inset-0 -z-10 origin-left scale-x-0 bg-white transition-transform duration-300 ease-out group-hover:scale-x-100" />
                <span class="font-medium transition-colors duration-300 group-hover:text-neutral-900">
                  Let's talk
                </span>
                <IconArrowNarrowRight
                  stroke={1.5}
                  aria-hidden="true"
                  class="transition-all duration-300 group-hover:translate-x-1 group-hover:text-neutral-900"
                />
              </button>
            </div>
          </div>
        </section>

        <section id="what-we-do" class="relative">
          <div class="-mb-px px-page h-15 w-full rounded-t-[300%_100%] sm:rounded-t-[200%_100%] md:rounded-t-[150%_100%] bg-white" />
          <div class="flex min-h-svh scroll-mt-24 flex-col justify-center bg-white py-20 text-neutral-900">
            <div class="mx-auto w-full max-w-275 px-page sm:px-page-sm">
              <div class="max-w-3xl">
                <p class="text-sm font-medium uppercase tracking-[0.2em] text-neutral-500">
                  What We Do
                </p>
                <h2 class="mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl">
                  Websites that move your business{" "}
                  <span class="font-light italic text-[#2F4A3C]">forward.</span>
                </h2>
                <p class="mt-8 text-lg leading-relaxed text-neutral-600 sm:text-xl">
                  You've built your business on a good name and word of mouth. A
                  professional website can take that to the next level. Most
                  people look a business up online before reaching out, so yours
                  should give them confidence in choosing you.
                </p>
                <p class="mt-5 text-lg leading-relaxed text-neutral-600 sm:text-xl">
                  Ymlaen means "ahead" in Welsh, and that's what we want for
                  your business. We build bespoke, hand-coded websites designed
                  around you and your customers. Built for speed and
                  performance, they keep Google happy and help more customers
                  find you.
                </p>
                <p class="mt-5 text-lg leading-relaxed text-neutral-600 sm:text-xl">
                  We also take care of edits and ongoing support, so you're
                  never left in the dark. Our goal is to build lasting
                  relationships with our clients and support their growth.
                </p>
              </div>
            </div>
          </div>
        </section>
        <div class="h-45 bg-white"></div>

        <section id="work" class="relative scroll-mt-48 pb-24">
          <div class="-mt-15 -mb-px h-15 w-full rounded-t-[300%_100%] sm:rounded-t-[200%_100%] md:rounded-t-[150%_100%] bg-[#1F2B24]"></div>
          <div class="bg-[#1F2B24] pt-10 pb-24 text-white sm:pt-16 sm:pb-32">
            <div class="mx-auto max-w-275 px-page sm:px-page-sm pt-30">
              <p class="text-sm font-medium uppercase tracking-[0.2em] text-neutral-400">
                Showcase
              </p>
              <h2 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl">
                Recent builds,{" "}
                <span class="font-light italic text-[#8e9a4e]">
                  made to win work.
                </span>
              </h2>
              <p class="mt-8 max-w-2xl text-lg leading-relaxed text-neutral-300 sm:text-xl">
                Whether you're a self-employed plumber or a growing building
                firm, we make websites that turn visitors into customers
              </p>

              <div class="relative mt-16 aspect-4/3 overflow-hidden rounded-3xl border border-white/10 sm:aspect-21/9">
                <Image
                  src={landscapeImage}
                  alt=""
                  sizes="(min-width: 1100px) 1100px, 100vw"
                  quality={75}
                  format="webp"
                  class="absolute inset-0 h-full w-full object-cover"
                  inferSize
                />
              </div>

              <div class="mt-16 grid gap-6 sm:grid-cols-3">
                {showcase.map((project) => (
                  <article class="rounded-3xl border border-white/10 bg-white/5 p-3 transition-transform duration-300 hover:-translate-y-1">
                    <div class="aspect-4/3 rounded-2xl bg-white/5 ring-1 ring-white/10"></div>
                    <div class="px-2 pb-2 pt-5">
                      <h3 class="text-lg font-semibold tracking-tight">
                        {project.name}
                      </h3>
                      <p class="mt-1 text-sm font-medium uppercase tracking-[0.15em] text-neutral-400">
                        {project.trade}
                      </p>
                      <p class="mt-3 text-sm leading-relaxed text-neutral-300 sm:text-base">
                        {project.blurb}
                      </p>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </section>

        <footer class="relative bg-white">
          <div class="mx-auto max-w-275 px-page py-5 sm:px-page-sm sm:py-28">
            <div class="rounded-3xl bg-[#1F2B24] px-8 py-14 text-center text-white sm:px-16 sm:py-20">
              <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-5xl">
                Looking for a new website?
              </h2>
              <p class="mx-auto mt-5 max-w-2xl text-lg text-neutral-300">
                Let us know what you're looking for, and we'll get back to you
                right away.
              </p>
              <a
                href="mailto:hello@example.com"
                class="mt-10 inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 font-medium text-neutral-900 no-underline transition-transform hover:scale-105"
              >
                Start a conversation
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>

<script>
  import { ScrollSmoother, ScrollTrigger } from "../lib/gsap"

  const smoother = ScrollSmoother.create({
    wrapper: "#smoother-wrapper",
    content: "#smoother-content",
    smooth: 1.5,
    effects: true,
  })

  ScrollTrigger.create({
    trigger: "#hero",
    pin: true,
    pinSpacing: false,
  })

  ScrollTrigger.create({
    trigger: "#what-we-do",
    start: "bottom bottom",
    pin: true,
    pinSpacing: false,
  })

  ScrollTrigger.create({
    trigger: "#work",
    start: "bottom bottom",
    pin: true,
    pinSpacing: false,
  })

  ScrollTrigger.create({
    trigger: "#what-we-do",
    start: "top top+=35",
    toggleClass: { targets: "#header", className: "bg-white!" },
  })

  ScrollTrigger.create({
    trigger: "#work",
    start: "top top+=35",
    toggleClass: { targets: "#header", className: "bg-[#1F2B24]!" },
  })

  ScrollTrigger.create({
    trigger: "#work",
    start: "top top+=35",
    toggleClass: { targets: "#brand, #nav", className: "text-white!" },
  })

  document
    .querySelectorAll<HTMLAnchorElement>('#nav a[href^="#"]')
    .forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault()
        smoother.scrollTo(link.getAttribute("href")!, true, "top -59px")
      })
    })
</script>
